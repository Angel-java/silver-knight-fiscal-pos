# Silver Knight - Variables de entorno para Docker Compose
# Ejecuta "npm run setup" para generar credenciales seguras automaticamente

# PostgreSQL (generado por npm run setup)
POSTGRES_USER=silverknight
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=silverknight

# Express Server
PORT=3001
CORS_ORIGIN=*
LOG_LEVEL=info

ROOT_USERNAME=admin
# ROOT_PIN (PIN del admin root; si queda vacío, no se reconcilia el root)
ROOT_PIN=

# JWT (generado por npm run setup)
# JWT_SECRET=
