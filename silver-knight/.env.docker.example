# Silver Knight - Variables de entorno para Docker Compose
# Copia este archivo como .env y ajusta los valores

# PostgreSQL
POSTGRES_USER=silverknight
POSTGRES_PASSWORD=REDACTED_DB_PASS
POSTGRES_DB=silverknight

# Express Server
PORT=3001
CORS_ORIGIN=*
LOG_LEVEL=info

# JWT (opcional - se auto-genera si no se provee)
# JWT_SECRET=REDACTED_JWT
