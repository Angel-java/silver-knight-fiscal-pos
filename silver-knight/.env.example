# Silver Knight - Variables de entorno
# Copia este archivo como .env y ajusta los valores

# PostgreSQL
DATABASE_URL="postgresql://silverknight:REDACTED_DB_PASS@localhost:5432/silverknight?schema=public"

# Secreto para firmar JWT (opcional - se auto-genera si no se provee)
# JWT_SECRET="REDACTED_JWT"

# Puerto del servidor Express (default: 3001)
# PORT=3001

# Nivel de logs: debug | info | warn | error
# LOG_LEVEL="info"

# Origen permitido para CORS (separado por comas, o * para todos)
# CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
