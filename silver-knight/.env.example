# Silver Knight - Variables de entorno
# Ejecuta "npm run setup" para generar credenciales seguras automaticamente

# PostgreSQL (generado por npm run setup)
POSTGRES_USER=silverknight
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=silverknight
DATABASE_URL="postgresql://silverknight:CHANGEME@localhost:5432/silverknight?schema=public"

# Username del admin root (default: admin)
# ROOT_USERNAME=admin

# PIN del admin root (generado por npm run setup)
ROOT_PIN=CHANGEME

# Secreto para firmar JWT (generado por npm run setup)
# JWT_SECRET=""

# Puerto del servidor Express (default: 3001)
# PORT=3001

# Nivel de logs: debug | info | warn | error
# LOG_LEVEL="info"

# Origen permitido para CORS (separado por comas, o * para todos)
# CORS_ORIGIN="http://localhost:5173,http://localhost:3001"
