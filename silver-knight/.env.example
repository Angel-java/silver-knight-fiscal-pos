# Silver Knight - Variables de entorno
# Copia este archivo como .env y ajusta los valores

# URL de conexion a SQLite
DATABASE_URL="file:./dev.db"

# Secreto para firmar JWT (opcional - se auto-genera si no se provee)
# JWT_SECRET="tu-secreto-aqui"

# Puerto del servidor Express (default: 3001)
# PORT=3001

# Nivel de logs: debug | info | warn | error
# LOG_LEVEL="info"

# Origen permitido para CORS
# CORS_ORIGIN="*"
