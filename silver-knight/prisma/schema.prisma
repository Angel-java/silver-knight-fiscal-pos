generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  rif       String   @unique
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  fullName    String?
  pin         String
  role        String    @default("operador")
  permissions String?
  isActive    Boolean   @default(true)
  invoices    Invoice[]
  reservations Reservation[]
  reservationPayments ReservationPayment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  rate      Float
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  rif       String?
  phone     String?
  email     String?
  address   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String              @id @default(cuid())
  name          String
  code          String?             @unique
  barcode       String?             @unique
  description   String?
  priceUsd      Float
  costUsd       Float?
  ivaRate       Float               @default(16)
  stock         Float               @default(0)
  minStock      Float               @default(0)
  categoryId    String?
  category      Category?           @relation(fields: [categoryId], references: [id])
  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  movements     InventoryMovement[]
  invoiceItems  InvoiceItem[]
  reservationItems ReservationItem[]
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  rif           String?   @unique
  address       String?
  phone         String?
  email         String?
  creditLimitUsd Float?
  invoices      Invoice[]
  reservations  Reservation[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FiscalControl {
  id              String   @id @default(cuid())
  documentType    String   // FACT, NCR, NDB
  resolution      String   // Número de resolución/autorización SENIAT
  prefix          String   // Prefijo del CF (ej: 0F, 0C, 0D)
  startNumber     Int      // Inicio del rango autorizado
  endNumber       Int      // Fin del rango autorizado
  currentNumber   Int      // Último número usado
  isActive        Boolean  @default(true)
  issuedAt        DateTime // Fecha de la resolución
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]

  @@unique([documentType, prefix])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  documentType    String        @default("FACT")  // FACT, NCR, NDB
  controlNumber   String?       // Número CF (Comprobante Fiscal) — formato SENIAT
  fiscalControlId String?
  fiscalControl   FiscalControl? @relation(fields: [fiscalControlId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  cancelReason    String?
  cancelledAt     DateTime?
  items           InvoiceItem[]
  totalUsd        Float
  totalVes        Float
  ivaUsd          Float
  ivaVes          Float
  currency        String        @default("USD")
  exchangeRate    Float
  status          String        @default("active")
  payments        String?       // JSON string with payment methods
  importedFrom    String?       // 'backup' cuando la factura vino de una importación (histórica)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([documentType, status])
  @@index([customerId])
  @@index([fiscalControlId])
  @@index([userId])

  reservationFrom Reservation[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  quantity    Float
  unitPriceUsd Float
  unitPriceVes Float
  ivaRate     Float
  totalUsd    Float
  totalVes    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SyncLog {
  id        String    @id @default(cuid())
  entity    String
  action    String
  entityId  String
  status    String    @default("pending")
  error     String?
  createdAt DateTime  @default(now())
  syncedAt  DateTime?
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // entry | exit | sale | cancellation
  quantity    Float
  unitCostUsd Float?
  reference   String?
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([type])
}

model SyncConfig {
  id        String   @id @default(cuid())
  url       String   @default("")
  apiKey    String   @default("")
  enabled   Boolean  @default(false)
  interval  Int      @default(60)
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MigrationLog {
  id          String   @id @default(cuid())
  kind        String   // backup | csv
  entity      String?
  strategy    String   // skip | overwrite | create-new
  imported    Int      @default(0)
  skipped     Int      @default(0)
  errors      Int      @default(0)
  errorDetail String?
  fileName    String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Reservation {
  id            String               @id @default(cuid())
  number        String               @unique // ej: AP-20260828-0001
  customerId    String?
  customer      Customer?            @relation(fields: [customerId], references: [id])
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  status        String               @default("active") // active | finalized | cancelled | expired
  totalUsd      Float
  totalVes      Float
  exchangeRate  Float                // tasa congelada al crear
  currency      String               @default("USD")
  amountPaidUsd Float                @default(0)
  depositUsd    Float                // abono inicial
  dueDate       DateTime?
  notes         String?
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
  finalizedAt   DateTime?
  invoiceId     String?              // factura fiscal final generada
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id])
  items         ReservationItem[]
  payments      ReservationPayment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model ReservationItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  productName   String
  quantity      Float
  unitPriceUsd  Float
  unitPriceVes  Float
  ivaRate       Float
  totalUsd      Float
  totalVes      Float
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@index([productId])
}

model ReservationPayment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountUsd     Float
  amountVes     Float
  method        String      // cash_usd | cash_ves | transfer | pos | mixed
  detail        String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}
